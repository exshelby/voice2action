generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FeedbackStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED

  @@map("feedback_status")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum TicketTeam {
  LOGISTICS
  QUALITY
  FINANCE
  CUSTOMER_SUPPORT
  TECHNICAL_SUPPORT
  CUSTOMER_EXPERIENCE
  GENERAL_SUPPORT

  @@map("ticket_team")
}

enum TicketWorklogType {
  INVESTIGATION
  RESOLUTION

  @@map("ticket_worklog_type")
}

enum NotificationType {
  TICKET_ASSIGNED

  @@map("notification_type")
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED

  @@map("notification_status")
}

model Feedback {
  id                        String         @id @default(uuid()) @db.Uuid
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @updatedAt @map("updated_at")
  audioObjectKey            String         @map("audio_object_key")
  mimeType                  String         @map("mime_type")
  fileSizeBytes             Int            @map("file_size_bytes")
  durationMs                Int?           @map("duration_ms")
  transcriptionRequestedAt  DateTime?      @map("transcription_requested_at")
  originalTranscript        String?        @map("original_transcript") @db.Text
  transcribedAt             DateTime?      @map("transcribed_at")
  transcriptionError        String?        @map("transcription_error") @db.Text
  classificationStartedAt   DateTime?      @map("classification_started_at")
  classificationCategory    String?        @map("classification_category")
  classificationSummary     String?        @map("classification_summary") @db.Text
  classificationScore       Float?         @map("classification_score")
  classificationNeedsReview Boolean?       @map("classification_needs_review")
  classificationModel       String?        @map("classification_model")
  classifiedAt              DateTime?      @map("classified_at")
  classificationError       String?        @map("classification_error") @db.Text
  reviewedTranscript        String?        @map("reviewed_transcript") @db.Text
  reviewedCategory          String?        @map("reviewed_category")
  reviewedSummary           String?        @map("reviewed_summary") @db.Text
  reviewedAt                DateTime?      @map("reviewed_at")
  reviewRevision            Int            @default(0) @map("review_revision")
  status                    FeedbackStatus @default(RECEIVED)
  ticket                    Ticket?

  @@index([status])
  @@index([createdAt])
  @@map("feedback")
}

model Ticket {
  id                    String              @id @default(uuid()) @db.Uuid
  ticketNumber          Int                 @unique @default(autoincrement()) @map("ticket_number")
  feedbackId            String              @unique @map("feedback_id") @db.Uuid
  title                 String
  description           String              @db.Text
  category              String
  sourceReviewRevision  Int                 @map("source_review_revision")
  sourceReviewedAt      DateTime            @map("source_reviewed_at")
  status                TicketStatus        @default(OPEN)
  assignedTeam          TicketTeam?         @map("assigned_team")
  assignmentRuleVersion Int?                @map("assignment_rule_version")
  assignedAt            DateTime?           @map("assigned_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  feedback              Feedback            @relation(fields: [feedbackId], references: [id], onDelete: Restrict)
  notifications         Notification[]
  statusEvents          TicketStatusEvent[]
  worklogs              TicketWorklog[]

  @@index([status])
  @@index([assignedTeam])
  @@index([createdAt])
  @@map("ticket")
}

model TicketStatusEvent {
  id         Int           @id @default(autoincrement())
  ticketId   String        @map("ticket_id") @db.Uuid
  fromStatus TicketStatus? @map("from_status")
  toStatus   TicketStatus  @map("to_status")
  createdAt  DateTime      @default(now()) @map("created_at")
  ticket     Ticket        @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("ticket_status_event")
}

model TicketWorklog {
  id        Int               @id @default(autoincrement())
  ticketId  String            @map("ticket_id") @db.Uuid
  type      TicketWorklogType
  body      String            @db.Text
  createdAt DateTime          @default(now()) @map("created_at")
  ticket    Ticket            @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("ticket_worklog")
}

model Notification {
  id           Int                @id @default(autoincrement())
  ticketId     String             @map("ticket_id") @db.Uuid
  team         TicketTeam
  eventType    NotificationType   @map("event_type")
  subject      String
  message      String             @db.Text
  status       NotificationStatus @default(PENDING)
  attemptCount Int                @default(0) @map("attempt_count")
  lastError    String?            @map("last_error") @db.Text
  sentAt       DateTime?          @map("sent_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  ticket       Ticket             @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@unique([ticketId, eventType])
  @@index([status, createdAt])
  @@index([team, status])
  @@map("notification")
}
