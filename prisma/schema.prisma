generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FeedbackStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED

  @@map("feedback_status")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL

  @@map("ticket_priority")
}

enum TicketTeam {
  LOGISTICS
  QUALITY
  FINANCE
  CUSTOMER_SUPPORT
  TECHNICAL_SUPPORT
  CUSTOMER_EXPERIENCE
  GENERAL_SUPPORT

  @@map("ticket_team")
}

enum TicketWorklogType {
  INVESTIGATION
  RESOLUTION

  @@map("ticket_worklog_type")
}

enum NotificationType {
  TICKET_ASSIGNED

  @@map("notification_type")
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED

  @@map("notification_status")
}

model Feedback {
  id                        String         @id @default(uuid()) @db.Uuid
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @updatedAt @map("updated_at")
  audioObjectKey            String         @map("audio_object_key")
  mimeType                  String         @map("mime_type")
  fileSizeBytes             Int            @map("file_size_bytes")
  durationMs                Int?           @map("duration_ms")
  transcriptionRequestedAt  DateTime?      @map("transcription_requested_at")
  originalTranscript        String?        @map("original_transcript") @db.Text
  transcribedAt             DateTime?      @map("transcribed_at")
  transcriptionError        String?        @map("transcription_error") @db.Text
  classificationStartedAt   DateTime?      @map("classification_started_at")
  classificationCategory    String?        @map("classification_category")
  classificationSummary     String?        @map("classification_summary") @db.Text
  classificationScore       Float?         @map("classification_score")
  classificationNeedsReview Boolean?       @map("classification_needs_review")
  classificationModel       String?        @map("classification_model")
  classifiedAt              DateTime?      @map("classified_at")
  classificationError       String?        @map("classification_error") @db.Text
  reviewedTranscript        String?        @map("reviewed_transcript") @db.Text
  reviewedCategory          String?        @map("reviewed_category")
  reviewedSummary           String?        @map("reviewed_summary") @db.Text
  reviewedAt                DateTime?      @map("reviewed_at")
  reviewedById              String?        @map("reviewed_by_id") @db.Uuid
  reviewRevision            Int            @default(0) @map("review_revision")
  status                    FeedbackStatus @default(RECEIVED)
  reviewedBy                Operator?      @relation("FeedbackReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  ticket                    Ticket?

  @@index([status])
  @@index([createdAt])
  @@index([reviewedById])
  @@map("feedback")
}

model Ticket {
  id                    String                @id @default(uuid()) @db.Uuid
  ticketNumber          Int                   @unique @default(autoincrement()) @map("ticket_number")
  feedbackId            String                @unique @map("feedback_id") @db.Uuid
  title                 String
  description           String                @db.Text
  category              String
  sourceReviewRevision  Int                   @map("source_review_revision")
  sourceReviewedAt      DateTime              @map("source_reviewed_at")
  status                TicketStatus          @default(OPEN)
  priority              TicketPriority        @default(NORMAL)
  responseDueAt         DateTime              @default(dbgenerated()) @map("response_due_at")
  resolutionDueAt       DateTime              @default(dbgenerated()) @map("resolution_due_at")
  respondedAt           DateTime?             @map("responded_at")
  assignedTeam          TicketTeam?           @map("assigned_team")
  assignmentRuleVersion Int?                  @map("assignment_rule_version")
  assignedAt            DateTime?             @map("assigned_at")
  createdById           String?               @map("created_by_id") @db.Uuid
  assignedById          String?               @map("assigned_by_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  createdBy             Operator?             @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedBy            Operator?             @relation("TicketAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  feedback              Feedback              @relation(fields: [feedbackId], references: [id], onDelete: Restrict)
  notifications         Notification[]
  priorityEvents        TicketPriorityEvent[]
  statusEvents          TicketStatusEvent[]
  worklogs              TicketWorklog[]

  @@index([status])
  @@index([priority])
  @@index([responseDueAt])
  @@index([resolutionDueAt])
  @@index([assignedTeam])
  @@index([createdById])
  @@index([assignedById])
  @@index([createdAt])
  @@map("ticket")
}

model TicketPriorityEvent {
  id           Int             @id @default(autoincrement())
  ticketId     String          @map("ticket_id") @db.Uuid
  fromPriority TicketPriority? @map("from_priority")
  toPriority   TicketPriority  @map("to_priority")
  operatorId   String?         @map("operator_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  operator     Operator?       @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  ticket       Ticket          @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([operatorId])
  @@map("ticket_priority_event")
}

model TicketStatusEvent {
  id         Int           @id @default(autoincrement())
  ticketId   String        @map("ticket_id") @db.Uuid
  fromStatus TicketStatus? @map("from_status")
  toStatus   TicketStatus  @map("to_status")
  operatorId String?       @map("operator_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at")
  operator   Operator?     @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  ticket     Ticket        @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([operatorId])
  @@map("ticket_status_event")
}

model TicketWorklog {
  id         Int               @id @default(autoincrement())
  ticketId   String            @map("ticket_id") @db.Uuid
  type       TicketWorklogType
  body       String            @db.Text
  operatorId String?           @map("operator_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at")
  operator   Operator?         @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  ticket     Ticket            @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([operatorId])
  @@map("ticket_worklog")
}

model Notification {
  id                     Int                @id @default(autoincrement())
  ticketId               String             @map("ticket_id") @db.Uuid
  team                   TicketTeam
  eventType              NotificationType   @map("event_type")
  subject                String
  message                String             @db.Text
  status                 NotificationStatus @default(PENDING)
  attemptCount           Int                @default(0) @map("attempt_count")
  nextAttemptAt          DateTime           @default(now()) @map("next_attempt_at")
  deliveryClaimToken     String?            @map("delivery_claim_token") @db.Uuid
  deliveryLeaseExpiresAt DateTime?          @map("delivery_lease_expires_at")
  lastError              String?            @map("last_error") @db.Text
  sentAt                 DateTime?          @map("sent_at")
  deliveredById          String?            @map("delivered_by_id") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  deliveredBy            Operator?          @relation("NotificationDeliverer", fields: [deliveredById], references: [id], onDelete: Restrict)
  ticket                 Ticket             @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@unique([ticketId, eventType])
  @@index([status, nextAttemptAt, createdAt])
  @@index([team, status])
  @@index([deliveredById])
  @@map("notification")
}

model Operator {
  id                     String                @id @default(uuid()) @db.Uuid
  username               String                @unique
  displayName            String                @map("display_name")
  passwordHash           String                @map("password_hash")
  active                 Boolean               @default(true)
  failedLoginCount       Int                   @default(0) @map("failed_login_count")
  lockedUntil            DateTime?             @map("locked_until")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  assignedTickets        Ticket[]              @relation("TicketAssigner")
  createdTickets         Ticket[]              @relation("TicketCreator")
  deliveredNotifications Notification[]        @relation("NotificationDeliverer")
  priorityEvents         TicketPriorityEvent[]
  reviewedFeedback       Feedback[]            @relation("FeedbackReviewer")
  sessions               OperatorSession[]
  statusEvents           TicketStatusEvent[]
  worklogs               TicketWorklog[]

  @@map("operator")
}

model OperatorSession {
  id         String   @id @default(uuid()) @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId, expiresAt])
  @@index([expiresAt])
  @@map("operator_session")
}
