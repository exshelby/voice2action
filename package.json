{
  "name": "voice2action",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "test:python": "python scripts/test_local_classify.py",
    "verify": "npm run test && npm run test:python && npm run lint && npm run typecheck && npm run build",
    "smoke:local": "node scripts/smoke-http.mjs",
    "backup:local": "node scripts/backup-local-data.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "retention:audio": "node scripts/retire-audio.mjs",
    "operator:create": "node scripts/create-operator.mjs",
    "notification:list": "node scripts/list-notifications.mjs",
    "notification:deliver:once": "node scripts/deliver-notifications.mjs --once",
    "notification:deliver:watch": "node scripts/deliver-notifications.mjs --watch",
    "transcribe:once": "node scripts/transcribe-feedback.mjs --once",
    "transcribe:watch": "node scripts/transcribe-feedback.mjs --watch",
    "transcribe:show": "node scripts/show-transcript.mjs",
    "classify:once": "node scripts/classify-feedback.mjs --once",
    "classify:watch": "node scripts/classify-feedback.mjs --watch",
    "review:feedback": "node scripts/review-feedback.mjs",
    "ticket:create": "node scripts/create-ticket.mjs",
    "ticket:assign": "node scripts/assign-ticket.mjs",
    "ticket:show": "node scripts/show-ticket.mjs",
    "ticket:update": "node scripts/update-ticket.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.1",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "mysql2": "3.23.1"
  }
}
